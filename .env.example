# Database — pode ser Postgres local ou Supabase Postgres
# Supabase: Settings > Database > Connection string > URI
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Exemplo Supabase:
# DATABASE_URL=postgresql://postgres:[SUA-SENHA]@db.[SEU-PROJETO].supabase.co:5432/postgres

# Supabase JS Client (para Storage, Auth, Realtime)
# Supabase: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ... # opcional, só server-side, para operações admin

# Opcional: para upload de imagens de loja/produto no Storage
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=coremotion
